# Copy to .env on the VM (never commit the real .env — it's gitignored)
# and fill in real values before `docker compose up -d`.

# Free subdomain from https://www.duckdns.org — e.g. chennai-transit.duckdns.org
DUCKDNS_DOMAIN=your-subdomain.duckdns.org

# Required by Nominatim's usage policy: a real, identifying contact.
NOMINATIM_CONTACT=your-email@example.com

# Your Vercel deployment's exact origin (no trailing slash), e.g.
# https://chennai-transit.vercel.app — locks the API's CORS to this origin.
FRONTEND_ORIGIN=https://your-app.vercel.app
